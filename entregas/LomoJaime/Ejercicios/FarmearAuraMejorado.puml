@startuml
hide circle
hide empty members

class Persona {
  nombre
}
class Aura {
  /total
}
class Accion {
  descripcion
  fecha
  buscada
}
class Reaccion {
  intensidad
}
class CambioDeAura {
  cantidad
  fecha
}
enum TipoReaccion {
  ADMIRACION
  RISA
  INDIFERENCIA
  CRINGE
}

Persona "1" -- "1" Aura
Persona "autor 1" -- "*" Accion
Persona "observador 1" -- "*" Reaccion
Accion "1" -- "*" Reaccion
Reaccion ..> TipoReaccion
Reaccion "1" -- "1" CambioDeAura
Aura "1" *-- "*" CambioDeAura

note right of Reaccion
  Quien reacciona no puede
  ser quien hizo la acción
end note

note bottom of Aura
  El total es lo que resulta de sumar
  todos los cambios de aura.
  Así se sabe por qué subió o bajó.
end note
@enduml